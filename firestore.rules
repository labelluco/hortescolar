// Reglas de seguridad de Firestore del proyecto «huerto-escolar-66b3d».
//
// Se copian a mano en la consola de Firebase (Firestore Database → Reglas)
// cada vez que cambian aquí.
//
// Quién es quién:
//   - Sin sesión: cualquiera con el enlace.
//   - Profesorado: cualquier cuenta con sesión. Las cuentas se crean en la
//     consola (Authentication) y el registro libre está desactivado.
//   - Revisores: el profesorado cuyo correo está en la lista «revisores» del
//     documento config/roles (se edita en la consola; nadie puede cambiarlo
//     desde la web).
//
// Qué puede hacer cada uno (lo mismo que js/modelo/permisos.js):
//   - Actividades publicadas: las lee cualquiera.
//   - Actividades pendientes: solo las lee el profesorado.
//   - Profesorado: crea actividades pendientes a su nombre y edita o borra
//     las suyas mientras están pendientes (siguen pendientes).
//   - Revisores: crean, editan, aprueban y borran cualquier actividad.
//   - Imágenes: las lee cualquiera; las sube el profesorado a su nombre; las
//     cambia o borra quien las subió o un revisor. Los recursos (ficheros
//     para descargar), igual.
//   - Itinerarios: solo para el profesorado. Cada persona lee los suyos, los
//     compartidos con todos y los compartidos con ella (lista compartidoCon); los crea a su nombre y solo edita o borra los suyos
//     (aunque sean revisores). Nadie puede cambiar de quién es uno.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    function esRevisor() {
      return conSesion()
        && exists(/databases/$(database)/documents/config/roles)
        && correo() in get(/databases/$(database)/documents/config/roles).data.revisores;
    }

    match /config/roles {
      allow read: if conSesion();
      allow write: if false;
    }

    match /actividades/{id} {
      allow read: if conSesion() || resource.data.estado == 'publicada';

      allow create: if conSesion()
        && request.resource.data.creada.por == correo()
        && (esRevisor() || request.resource.data.estado == 'pendiente');

      allow update: if esRevisor()
        || (conSesion()
            && resource.data.estado == 'pendiente'
            && resource.data.creada.por == correo()
            && request.resource.data.estado == 'pendiente'
            && request.resource.data.creada == resource.data.creada);

      allow delete: if esRevisor()
        || (conSesion()
            && resource.data.estado == 'pendiente'
            && resource.data.creada.por == correo());
    }

    match /imagenes/{id} {
      allow read: if true;
      allow create: if conSesion() && request.resource.data.subidaPor == correo();
      allow update, delete: if esRevisor()
        || (conSesion() && resource.data.subidaPor == correo());
    }

    // Los recursos (fichas, infografías…), igual que las imágenes
    match /recursos/{id} {
      allow read: if true;
      allow create: if conSesion() && request.resource.data.subidaPor == correo();
      allow update, delete: if esRevisor()
        || (conSesion() && resource.data.subidaPor == correo());
    }

    match /itinerarios/{id} {
      // La lista de correos con quien se comparte (puede faltar en los antiguos)
      function compartidoConValido() {
        return request.resource.data.get('compartidoCon', []) is list
          && request.resource.data.get('compartidoCon', []).size() <= 50;
      }

      allow read: if conSesion()
        && (resource.data.compartido == true
            || resource.data.propietario == correo()
            // Se lee el campo tal cual (sin get) para que Firestore acepte la
            // consulta array-contains; en los antiguos sin el campo, da error
            // y no cuenta, pero valen las otras dos condiciones.
            || correo() in resource.data.compartidoCon);

      allow create: if conSesion()
        && request.resource.data.propietario == correo()
        && request.resource.data.creada.por == correo()
        && request.resource.data.compartido is bool
        && compartidoConValido();

      allow update: if conSesion()
        && resource.data.propietario == correo()
        && request.resource.data.propietario == resource.data.propietario
        && request.resource.data.creada == resource.data.creada
        && request.resource.data.compartido is bool
        && compartidoConValido();

      allow delete: if conSesion() && resource.data.propietario == correo();
    }
  }
}
